PORT=3000
HOST=127.0.0.1
# Set 0.0.0.0 in containers / Railway. Never put secrets in VITE_* variables.
CACHE_DIR=.cache
# Persistent SQLite archive. Mount this directory on a durable deployment volume.
ARCHIVE_PATH=data/news.sqlite
# Optional NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Optional camera configuration, managed by the operator.
CAMERAS_CONFIG=config/cameras.json
# Optional access token for /api/* if exposing an instance outside your network.
# When set, users enter it through the dashboard's connection dialog.
PANTAU_API_TOKEN=
# Optional Global Forest Watch vector Data API key, server-side only.
GFW_API_KEY=
CONTEXT_CONFIG=config/context.json
CONTEXT_DATA_DIR=config/context-data

# Official social API preparation only. All values intentionally empty.
# Collection and OAuth flows are NOT implemented/enabled, even if these are filled.
# Never put secrets in VITE_* variables or commit .env.
X_BEARER_TOKEN=
X_SEARCH_QUERY=
THREADS_ACCESS_TOKEN=
THREADS_SEARCH_QUERY=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
META_GRAPH_VERSION=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=
