PORT=3000
HOST=127.0.0.1
# Set 0.0.0.0 in containers / Railway. Never put secrets in VITE_* variables.
CACHE_DIR=.cache
# Optional NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Optional trusted feed URLs, configured by the operator, not by visitors.
SOCIAL_CONFIG=config/social.json
CAMERAS_CONFIG=config/cameras.json
# Optional access token for /api/* if exposing an instance outside your network.
# When set, users enter it through the dashboard's connection dialog.
PANTAU_API_TOKEN=
# Optional Global Forest Watch vector Data API key, server-side only.
GFW_API_KEY=
CONTEXT_CONFIG=config/context.json
CONTEXT_DATA_DIR=config/context-data
