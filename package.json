{
  "name": "pantau",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:environment": "tsx scripts/smoke-environment.ts",
    "archive:backup": "tsx scripts/archive-backup.ts",
    "smoke:preservation": "tsx scripts/smoke-preservation.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.1",
    "hls.js": "^1.6.13",
    "leaflet": "^1.9.4",
    "robots-parser": "^3.0.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
